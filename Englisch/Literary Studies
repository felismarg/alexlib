<script>
function showSection(id){
  document.querySelectorAll('main section').forEach(function(s){s.style.display=(s.id===id)?'block':'none';});
  document.querySelectorAll('#nav button').forEach(function(b){b.classList.toggle('active',b.dataset.t===id);});
  window.scrollTo(0,0);
}
var cards=[
["How do English and Italian sonnets differ?","English: 3 quatrains + couplet, turn after line 12. Italian: octave + sestet, turn after the octave."],
["What is an eye-rhyme?","A rhyme that looks alike but sounds different, e.g. move / dove."],
["Name the three Aristotelian unities.","Action (no subplots), time (24 h max), place (one setting)."],
["Hamartia, hubris, catharsis?","Tragic error · overconfidence · cleansing effect of pity and fear."],
["Five stages of Freytag’s pyramid?","Exposition, complication, climax, reversal, catastrophe/dénouement."],
["Congruent vs. discrepant awareness?","Everyone knows the same vs. unequal knowledge; effect: dramatic irony."],
["Homodiegetic vs. heterodiegetic?","Narrator inside the character world (usually “I”) vs. outside (usually third person)."],
["Overt vs. covert narrator?","Overt: says “I”, comments, explains. Covert: neutral, unobtrusive, lets the story unfold."],
["Five forms of internal focalisation?","Fixed, variable, multiple, collective, zero."],
["Order from telling to showing?","Narrative report, indirect, free indirect, direct, free direct discourse."],
["What is the hermeneutic circle?","Read with preconceptions, change them, return with a new perspective, repeat."],
["What is hegemony (Gramsci)?","Ideology works only if the masses accept, internalise and reproduce it."],
["Iser’s gaps vs. Fish’s interpretive communities?","Iser: readers fill gaps. Fish: community membership shapes interpretation."],
["Three operations in telling the past?","Selection, connection (causal, contingent, adversary) and framing."]
];
var fc=document.getElementById('fc');
cards.forEach(function(c){
  var d=document.createElement('div');
  d.className='card';d.tabIndex=0;d.setAttribute('role','button');
  var f=document.createElement('div');f.className='front';f.textContent=c[0];
  var b=document.createElement('div');b.className='back';b.textContent=c[1];
  d.appendChild(f);d.appendChild(b);
  d.addEventListener('click',function(){d.classList.toggle('flipped');});
  d.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();d.classList.toggle('flipped');}});
  fc.appendChild(d);
});
</script>
